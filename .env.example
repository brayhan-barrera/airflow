# Airflow Environment Variables
# Copy this file to .env and modify as needed

# User ID for Airflow containers (use 50000 for Linux/macOS, 1000 for some setups)
AIRFLOW_UID=50000

# Secret key for Flask session encryption (CHANGE IN PRODUCTION!)
AIRFLOW_WEBSERVER_SECRET_KEY=your-secret-key-change-in-production

# Optional: Enable CeleryExecutor instead of LocalExecutor
# AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# Optional: Timezone
# AIRFLOW__CORE__DEFAULT_TIMEZONE=UTC

# Optional: Parallelism settings
# AIRFLOW__CORE__PARALLELISM=32
# AIRFLOW__CORE__DAG_CONCURRENCY=16

# Optional: Logging
# AIRFLOW__LOGGING__LOGGING_LEVEL=INFO